# Setup-Sherpa .env example
# Copy this to `.env` (in the same directory as your manifests) and fill in
# values. This file is committed; .env is not (gitignored — it holds secrets).
#
# Referenced by docker-run / docker-volume steps via `expansionTokens`:
#   [[step]]
#   type = "docker-run"
#   expansionTokens = ["MSSQL_SA_PASSWORD"]
#   command = "-d -e MSSQL_SA_PASSWORD=$MSSQL_SA_PASSWORD --name sql1 mcr/sql:latest"
#
# And by compose steps via --env-file for YAML interpolation.

MSSQL_SA_PASSWORD=ChangeMe_Strong_Password
